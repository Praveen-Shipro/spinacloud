# ------------------------------------------------------------------------------
# SpinACloud cPanel / Apache Configuration
# ------------------------------------------------------------------------------

Options -Indexes
RewriteEngine On

# Allow PHP endpoints directly
RewriteRule ^contact\.php$ - [L]

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Redirect /index.html to root /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
RewriteRule ^index\.html$ / [R=301,L]

# 3. 301 Redirects for legacy routes
RewriteRule ^terms-and-conditions/?$ /terms [R=301,L]
RewriteRule ^wp-cloud/?$ /wpcloud [R=301,L]

# 4. Remove .html extension if URL is directly accessed with .html
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP/
RewriteRule ^([^.]+)\.html$ /$1 [R=301,L]

# 5. Resolve clean URLs without .html (e.g. /about -> about.html, /wpcloud -> wpcloud.html)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# 6. Custom 404 Error Document
ErrorDocument 404 /404.html

# 7. Browser Caching for Next.js assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
